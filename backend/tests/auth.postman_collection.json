{
  "info": {
    "name": "AlgoLift Auth",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [{ "key": "baseUrl", "value": "http://localhost:3000/api" }, { "key": "token", "value": "" }],
  "item": [
    {
      "name": "Register",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\"email\":\"auth-test-{{$timestamp}}@example.com\",\"password\":\"Password123!\",\"displayName\":\"Auth Test\"}" },
        "url": "{{baseUrl}}/auth/register"
      },
      "event": [{ "listen": "test", "script": { "exec": ["pm.test('returns 201', () => pm.response.to.have.status(201));", "pm.test('returns JWT', () => pm.expect(pm.response.json().token).to.be.a('string'));", "pm.collectionVariables.set('token', pm.response.json().token);"] } }]
    },
    {
      "name": "Login",
      "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\"email\":\"replace-with-registered-email@example.com\",\"password\":\"Password123!\"}" }, "url": "{{baseUrl}}/auth/login" }
    },
    {
      "name": "Current user",
      "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }], "url": "{{baseUrl}}/auth/me" },
      "event": [{ "listen": "test", "script": { "exec": ["pm.test('returns 200', () => pm.response.to.have.status(200));", "pm.test('does not expose password hash', () => pm.expect(pm.response.text()).not.to.contain('passwordHash'));" ] } }]
    },
    {
      "name": "Reject invalid token",
      "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer invalid-token" }], "url": "{{baseUrl}}/auth/me" },
      "event": [{ "listen": "test", "script": { "exec": ["pm.test('returns 401', () => pm.response.to.have.status(401));"] } }]
    }
  ]
}
